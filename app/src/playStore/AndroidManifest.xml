<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Play Store Policy Shield:
      Guarantees REQUEST_INSTALL_PACKAGES is strictly forbidden in playStore (.aab) builds.
      Offline sharing in playStore flavor serves the Zero-Install Offline HTML5 PWA over LocalOnlyHotspot.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

</manifest>
